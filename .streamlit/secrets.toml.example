# 로컬에서는 이 파일을 .streamlit/secrets.toml로 복사해 값을 채우세요. (secrets.toml은 커밋되지 않습니다)
# Streamlit Community Cloud에서는 앱 설정 > Secrets에 같은 내용을 붙여 넣습니다.
# 로컬에서 secrets.toml이 없으면 프로젝트 루트의 .env를 대신 읽습니다.
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# 선택 설정
# VISION_MODEL = "google/gemma-4-26b-a4b-it:free"
# 기본 모델이 막혔을 때 차례로 쓸 예비 모델 (쉼표 구분, "none"이면 사용 안 함)
# FALLBACK_VISION_MODELS = "dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-super-vl:free"
# DAILY_REQUEST_LIMIT = "40"

# --- 3단계: 저장소 (없으면 로컬 개발용 SQLite 파일 data/local.db를 씁니다) ---
# Supabase 대시보드 > Connect > Session pooler 의 연결 문자열 (포트 5432, 직접 연결은 IPv6 전용이라 쓰지 않음)
# [connections.supabase]
# url = "postgresql+psycopg://postgres.<프로젝트ref>:<DB 비밀번호>@aws-0-<지역>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- 3단계: Google 로그인 (없으면 아이디 로그인만 쓸 수 있습니다) ---
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"   # 배포에서는 https://<앱이름>.streamlit.app/oauth2callback
# cookie_secret = "<무작위 긴 문자열>"
#
# [auth.google]
# client_id = "<Google OAuth 클라이언트 ID>"
# client_secret = "<Google OAuth 클라이언트 보안 비밀>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
